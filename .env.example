# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing secret for IZHO customer & admin authentication tokens.
JWT_SECRET="replace-with-a-random-64-char-secret"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Optional live Razorpay credentials.
# When omitted, IZHO runs a verified Razorpay test checkout simulation.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
